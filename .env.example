# Настройки для npm run dev: cp .env.example .env.local
# В образе вместо них - переменные контейнера, см. docker/entrypoint.d/40-app-config.sh

# Keycloak: публичный адрес и realm стенда, публичный клиент UI (Authorization Code + PKCE)
VITE_KEYCLOAK_URL=http://localhost:8180
VITE_KEYCLOAK_REALM=smart-factoring-test
VITE_KEYCLOAK_CLIENT_ID=smart-factoring-ui

# куда Vite проксирует /api (не VITE_: читается только в vite.config.ts)
# GATEWAY_URL=http://127.0.0.1:8090
